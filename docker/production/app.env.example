APP_NAME="Mini ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ERP_DOMAIN
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mini_erp
DB_USERNAME=mini_erp
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

FILESYSTEM_DISK=local
LEGACY_PHOTO_DISK=public
PRODUCT_PHOTO_DISK=public
PERSON_PHOTO_DISK=local
PUBLIC_STORAGE_URL=/storage
UPLOAD_PROXY_MAX_BYTES=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_ENDPOINT=
R2_PRODUCTS_BUCKET=
R2_PRODUCTS_PUBLIC_URL=
R2_PRIVATE_BUCKET=
R2_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Mini ERP"

SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=mini_erp_
CATALOG_API_RATE_LIMIT_PER_MINUTE=60
CATALOG_CREDENTIAL_KEY=
CATALOG_PUBLIC_URL=https://CATALOG_DOMAIN
CATALOG_QR_CODE_URL=https://quickchart.io/qr
CORS_ALLOWED_ORIGINS=https://CATALOG_DOMAIN
CORS_SUPPORTS_CREDENTIALS=false
